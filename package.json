{
  "name": "errorlife",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build": "npm run build --workspace=web",
    "vercel-build": "npm run build --workspace=web",
    "dev:mobile": "npm --prefix mobile start",
    "install:mobile": "npm --prefix mobile install --legacy-peer-deps",
    "lint": "npm run lint --workspace=web"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "dependencies": {
    "semver": "^7.8.1"
  }
}
